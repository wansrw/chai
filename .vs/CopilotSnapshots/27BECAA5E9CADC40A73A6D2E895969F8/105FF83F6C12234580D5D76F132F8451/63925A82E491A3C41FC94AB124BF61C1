<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\Order;
use App\Models\User;

class OrderController extends Controller
{
    public function index()
    {
        $orders = Order::with('items.product')->orderBy('id','desc')->paginate(25);
        return view('admin.orders.index', compact('orders'));
    }

    public function show($id)
    {
        $order = Order::with('items.product')->findOrFail($id);
        return view('admin.orders.show', compact('order'));
    }

    public function changeStatus(Request $request, $id)
    {
        $order = Order::findOrFail($id);
        $status = $request->input('status');
        $order->status = $status;
        $order->save();
        return redirect()->route('admin.orders.show', $id)->with('status', 'Статус обновлён');
    }

    public function create()
    {
        $users = User::orderBy('id','desc')->get();
        return view('admin.orders.create', compact('users'));
    }

    public function store(Request $request)
    {
        $data = $request->only(['user_id','total_price','status','name','phone','address','notes']);
        $request->validate([
            'user_id' => 'nullable|exists:users,id',
            'total_price' => 'required|numeric',
            'status' => 'nullable',
            'name' => 'required|string|max:255',
            'phone' => 'nullable|string|max:255',
            'address' => 'nullable|string|max:1000',
        ]);
        $order = Order::create($data);
        return redirect()->route('admin.orders.show', $order->id)->with('status', 'Заказ создан');
    }

    public function edit($id)
    {
        $order = Order::findOrFail($id);
        $users = User::orderBy('id','desc')->get();
        return view('admin.orders.edit', compact('order','users'));
    }

    public function update(Request $request, $id)
    {
        $order = Order::findOrFail($id);
        $data = $request->only(['user_id','total_price','status','name','phone','address','notes']);
        $request->validate([
            'user_id' => 'nullable|exists:users,id',
            'total_price' => 'required|numeric',
            'status' => 'nullable',
            'name' => 'required|string|max:255',
            'phone' => 'nullable|string|max:255',
            'address' => 'nullable|string|max:1000',
        ]);
        $order->update($data);
        return redirect()->route('admin.orders.show', $order->id)->with('status', 'Заказ обновлён');
    }

    public function destroy($id)
    {
        $order = Order::find($id);
        if ($order) $order->delete();
        return redirect()->route('admin.orders.index')->with('status', 'Заказ удалён');
    }

    // массовая смена статусов
    public function bulkStatus(Request $request)
    {
        $ids = $request->input('ids', []);
        $status = $request->input('status');
        if (!is_array($ids) || empty($ids) || !$status) {
            return redirect()->route('admin.orders.index')->with('status', 'Ничего не выбрано');
        }
        Order::whereIn('id', $ids)->update(['status' => $status]);
        return redirect()->route('admin.orders.index')->with('status', 'Статусы обновлены');
    }
}
