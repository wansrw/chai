<script>
document.addEventListener('DOMContentLoaded', function () {
    const pwd = document.getElementById('password');
    const strengthEl = document.getElementById('password-strength');
    if (!pwd || !strengthEl) return;

    function scorePassword(password) {
        let score = 0;
        if (!password) return score;
        // length
        if (password.length >= 8) score += 1;
        if (password.length >= 12) score += 1;
        // variety
        if (/[A-Z]/.test(password)) score += 1;
        if (/[0-9]/.test(password)) score += 1;
        if (/[^A-Za-z0-9]/.test(password)) score += 1;
        return score; // 0..5
    }

    function updateStrength(password) {
        const s = scorePassword(password);
        const segments = strengthEl.querySelectorAll('.strength-segment');
        segments.forEach((seg) => {
            seg.classList.remove('active');
            seg.style.opacity = '0.3';
        });

        let level = 'weak';
        if (s <= 1) level = 'weak';
        else if (s <= 2) level = 'fair';
        else if (s <= 4) level = 'good';
        else level = 'strong';

        strengthEl.setAttribute('data-bs-strength', level);

        // activate number of segments proportional to score (max 4)
        const activeCount = Math.min(4, Math.max(1, Math.ceil(s * 4 / 5)));
        for (let i = 0; i < activeCount; i++) {
            segments[i].classList.add('active');
            segments[i].style.opacity = '1';
        }
    }

    pwd.addEventListener('input', function (e) {
        updateStrength(e.target.value);
    });
});
</script>
