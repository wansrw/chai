<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\products;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Facades\Storage;
use App\Models\Kategory;

class ProductController extends Controller
{
    public function index()
    {
        $items = products::orderBy('id','desc')->paginate(25);
        return view('admin.products.index', compact('items'));
    }

    public function create()
    {
        $kats = Kategory::orderBy('name')->get();
        return view('admin.products.create', compact('kats'));
    }

    public function store(Request $request)
    {
        $data = $request->only(['name','price','year','country','model','kategory','image_link']);
        // handle uploaded image
        if ($request->hasFile('image') && $request->file('image')->isValid()) {
            $path = $request->file('image')->store('products', 'public');
            $data['image_link'] = Storage::url($path);
        }
        $v = Validator::make($data, [
            'name' => 'required|string|max:255',
            'price' => 'nullable|numeric',
        ]);

        if ($v->fails()) {
            return back()->withErrors($v)->withInput();
        }

        products::create($data);
        return redirect()->route('admin.products.index')->with('status', 'Товар создан');
    }

    public function edit($id)
    {
        $item = products::findOrFail($id);
        $kats = Kategory::orderBy('name')->get();
        return view('admin.products.edit', compact('item','kats'));
    }

    public function update(Request $request, $id)
    {
        $item = products::findOrFail($id);
        $data = $request->only(['name','price','year','country','model','kategory','image_link']);
        if ($request->hasFile('image') && $request->file('image')->isValid()) {
            $path = $request->file('image')->store('products', 'public');
            $data['image_link'] = Storage::url($path);
        }
        $v = Validator::make($data, [
            'name' => 'required|string|max:255',
            'price' => 'nullable|numeric',
        ]);

        if ($v->fails()) {
            return back()->withErrors($v)->withInput();
        }

        $item->update($data);
        return redirect()->route('admin.products.index')->with('status', 'Товар обновлён');
    }

    public function show($id)
    {
        $item = products::findOrFail($id);
        return view('admin.products.show', compact('item'));
    }

    public function destroy($id)
    {
        $item = products::find($id);
        if ($item) $item->delete();
        return redirect()->route('admin.products.index')->with('status', 'Товар удалён');
    }
}
