    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Инициализация bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })

            // Обработка форм удаления через модальное окно
            var deleteForms = document.querySelectorAll('.js-delete-form');
            var confirmModal = document.getElementById('confirmDeleteModal');
            var modalInstance = confirmModal ? new bootstrap.Modal(confirmModal) : null;
            var modalForm = document.getElementById('confirm-delete-form');
            var modalItemName = document.getElementById('confirm-delete-item');

            deleteForms.forEach(function(f){
                f.addEventListener('submit', function(e){
                    e.preventDefault();
                    var action = f.getAttribute('action');
                    var name = f.dataset.itemName || '';
                    if(modalForm && modalInstance){
                        modalForm.setAttribute('action', action);
                        if(modalItemName) modalItemName.textContent = name;
                        modalInstance.show();
                    } else {
                        // fallback если модал отсутствует
                        if(confirm('Удалить ' + name + '?')){ f.submit(); }
                    }
                });
            });
        });
    </script>

